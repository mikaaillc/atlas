rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if owns(uid);

      match /devices/{deviceId} {
        allow read: if owns(uid);
        allow create, update: if owns(uid)
          && request.resource.data.name is string
          && request.resource.data.kind is string
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.lowBatteryThreshold is int
          && request.resource.data.lowBatteryThreshold >= 5
          && request.resource.data.lowBatteryThreshold <= 50;
        allow delete: if owns(uid);

        match /history/{readingId} {
          allow read: if owns(uid);
          allow create: if owns(uid)
            && request.resource.data.level is int
            && request.resource.data.level >= 0
            && request.resource.data.level <= 100;
          allow update: if false;
          allow delete: if owns(uid);
        }
      }

      match /tokens/{token} {
        allow read, write: if owns(uid);
      }
    }

    // Atlas namespace. Existing BatteryLook permissions above are preserved.
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function text(s, max) { return s is string && s.size() <= max; }
    function date(s) { return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    // Dedicated namespace. No access to batteryLook /users documents.
    match /learningAtlas/{uid}/progress/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && (id.matches('^(english|aws)-[0-9]{1,3}$') || id.matches('^custom_[a-f0-9]{32}_[0-9]{1,3}$'))
        && request.resource.data.keys().hasOnly(['id','checks','notes','correction','evidence','score','total','completedAt','updatedAt'])
        && request.resource.data.id == id
        && request.resource.data.checks is list
        && request.resource.data.checks.size() <= 10
        && request.resource.data.checks.hasOnly([true,false])
        && text(request.resource.data.notes,20000)
        && text(request.resource.data.correction,10000)
        && text(request.resource.data.evidence,2000)
        && request.resource.data.score is int && request.resource.data.total is int
        && request.resource.data.score >= 0 && request.resource.data.total >= request.resource.data.score
        && request.resource.data.total <= 1000
        && (request.resource.data.completedAt == '' || date(request.resource.data.completedAt))
        && date(request.resource.data.updatedAt);
    }
    match /learningAtlas/{uid}/words/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['id','word','meaning','definition','example','sentence','type','source','lessonDay','created','stage','nextReview','lastReview'])
        && request.resource.data.id == id
        && text(request.resource.data.word,200) && request.resource.data.word.size()>0
        && text(request.resource.data.meaning,2000) && request.resource.data.meaning.size()>0
        && text(request.resource.data.sentence,2000) && request.resource.data.sentence.size()>0
        && text(request.resource.data.definition,2000) && text(request.resource.data.example,2000)
        && text(request.resource.data.type,2000) && text(request.resource.data.source,2000)
        && request.resource.data.lessonDay is int && request.resource.data.lessonDay >= 1 && request.resource.data.lessonDay <= 546
        && request.resource.data.stage is int && request.resource.data.stage >= 0 && request.resource.data.stage <= 4
        && date(request.resource.data.created)
        && (request.resource.data.nextReview == '' && request.resource.data.stage == 4 || date(request.resource.data.nextReview))
        && (request.resource.data.lastReview == '' || date(request.resource.data.lastReview));
    }
    // Assigned catalog: only the metadata owner may read metadata, days and PDFs.
    function catalogOwner(planId) {
      return request.auth != null
        && get(/databases/$(database)/documents/learningAtlasCatalog/$(planId)).data.ownerUid == request.auth.uid;
    }
    match /learningAtlasCatalog/{planId} {
      allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
      match /{content=**} { allow read: if catalogOwner(planId); allow write: if false; }
    }
    function boundedStringAt(items, i, max) { return items.size() <= i || text(items[i], max) && items[i].size() > 0; }
    function validTasks(items) {
      return items is list && items.size() >= 1 && items.size() <= 10
        && boundedStringAt(items,0,5000) && boundedStringAt(items,1,5000)
        && boundedStringAt(items,2,5000) && boundedStringAt(items,3,5000)
        && boundedStringAt(items,4,5000) && boundedStringAt(items,5,5000)
        && boundedStringAt(items,6,5000) && boundedStringAt(items,7,5000)
        && boundedStringAt(items,8,5000) && boundedStringAt(items,9,5000);
    }
    function validLinkAt(items, i) {
      return items.size() <= i || items[i] is map
        && items[i].keys().hasOnly(['label','url'])
        && text(items[i].label,160) && items[i].label.size() > 0
        && text(items[i].url,2000) && items[i].url.matches('^https://[^ /]+/?.*$');
    }
    function validLinks(items) {
      return items is list && items.size() <= 8
        && validLinkAt(items,0) && validLinkAt(items,1) && validLinkAt(items,2) && validLinkAt(items,3)
        && validLinkAt(items,4) && validLinkAt(items,5) && validLinkAt(items,6) && validLinkAt(items,7);
    }
    match /learningAtlas/{uid}/plans/{planId} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && planId.matches('^custom_[a-f0-9]{32}$')
        && request.resource.data.keys().hasOnly(['id','title','description','startDate','endDate','dailyMinutes','studyDays','dayCount','schemaVersion','source','status','hasPdf','color','createdAt','updatedAt'])
        && request.resource.data.id == planId
        && text(request.resource.data.title,160) && request.resource.data.title.size() > 0
        && text(request.resource.data.description,4000)
        && date(request.resource.data.startDate) && date(request.resource.data.endDate)
        && request.resource.data.dailyMinutes is int && request.resource.data.dailyMinutes >= 5 && request.resource.data.dailyMinutes <= 480
        && request.resource.data.studyDays is list && request.resource.data.studyDays.size() >= 1 && request.resource.data.studyDays.size() <= 7
        && request.resource.data.studyDays.hasOnly([0,1,2,3,4,5,6])
        && request.resource.data.dayCount is int && request.resource.data.dayCount >= 1 && request.resource.data.dayCount <= 730
        && request.resource.data.schemaVersion == 1 && request.resource.data.source == 'custom'
        && request.resource.data.status in ['importing','ready'] && request.resource.data.hasPdf == false
        && request.resource.data.color in ['violet','cyan','amber']
        && date(request.resource.data.createdAt) && date(request.resource.data.updatedAt);
      allow delete: if false;
      match /lessons/{lessonId} {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && exists(/databases/$(database)/documents/learningAtlas/$(uid)/plans/$(planId))
          && lessonId.matches('^custom_[a-f0-9]{32}_[0-9]{1,3}$')
          && request.resource.data.keys().hasOnly(['id','track','planId','day','date','level','week','minutes','title','focus','kind','tasks','links','page'])
          && request.resource.data.id == lessonId && request.resource.data.planId == planId && request.resource.data.track == planId
          && request.resource.data.day is int && request.resource.data.day >= 1 && request.resource.data.day <= 730
          && date(request.resource.data.date)
          && text(request.resource.data.level,80) && text(request.resource.data.kind,100)
          && request.resource.data.week is int && request.resource.data.week >= 1 && request.resource.data.week <= 105
          && request.resource.data.minutes is int && request.resource.data.minutes >= 5 && request.resource.data.minutes <= 480
          && text(request.resource.data.title,200) && request.resource.data.title.size() > 0
          && text(request.resource.data.focus,300) && request.resource.data.page == 0
          && validTasks(request.resource.data.tasks) && validLinks(request.resource.data.links);
        allow delete: if false;
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}

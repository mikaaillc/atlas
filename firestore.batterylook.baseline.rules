rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if owns(uid);

      match /devices/{deviceId} {
        allow read: if owns(uid);
        allow create, update: if owns(uid)
          && request.resource.data.name is string
          && request.resource.data.kind is string
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.lowBatteryThreshold is int
          && request.resource.data.lowBatteryThreshold >= 5
          && request.resource.data.lowBatteryThreshold <= 50;
        allow delete: if owns(uid);

        match /history/{readingId} {
          allow read: if owns(uid);
          allow create: if owns(uid)
            && request.resource.data.level is int
            && request.resource.data.level >= 0
            && request.resource.data.level <= 100;
          allow update: if false;
          allow delete: if owns(uid);
        }
      }

      match /tokens/{token} {
        allow read, write: if owns(uid);
      }
    }
  }
}

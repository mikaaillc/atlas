# Shared Rutinote Firebase project: Console > Project settings > Your apps > Web SDK config.
# All values intentionally blank. Never paste service-account/private keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=rutinote
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# For a separate named Firestore database, supply its ID. Empty = (default).
VITE_FIREBASE_DATABASE_ID=
# Local emulators ONLY. Leave false on Vercel.
VITE_USE_EMULATORS=false

# Existing Rutinote providers; no provider or password migration required.
VITE_AUTH_GOOGLE_ENABLED=true
VITE_AUTH_EMAIL_ENABLED=true

# Set true only after the combined Atlas rules are active in this database.
VITE_FIREBASE_RULES_READY=true
